generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CLIENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Level {
  KS3
  GCSE
  A_LEVEL
  UNIVERSITY_ADMISSIONS
}

enum AvailabilityPeriod {
  MORNING
  AFTERNOON
  EVENING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionMode {
  ONLINE
  IN_PERSON
  BOTH
}

enum TokenTransactionType {
  PURCHASE
  REDEEM
  REFUND
}

enum TutorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_TUTOR
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
}

enum LedgerEntryType {
  EARNING
  PLATFORM_FEE
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum PostType {
  BLOG
  NEWS
  TUTOR_SPOTLIGHT
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CourseStatus {
  UPCOMING
  PAST
}

// ---------- Core auth / users ----------

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role       @default(CLIENT)
  status          UserStatus @default(ACTIVE)
  image           String?
  newsletterOptIn Boolean    @default(false)
  agreedToTermsAt   DateTime?
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tutorProfile          TutorProfile?
  tutorApplication      TutorApplication?
  bookingsAsClient      Booking[]            @relation("ClientBookings")
  conversationsAsClient Conversation[]       @relation("ClientConversations")
  conversationsAsTutor  Conversation[]       @relation("TutorConversations")
  messagesSent          Message[]            @relation("SentMessages")
  reviewsWritten        Review[]             @relation("ClientReviews")
  passwordResetTokens   PasswordResetToken[]
  auditLogsAsActor      AuditLog[]           @relation("ActorAuditLogs")
  contactMessages       ContactMessage[]
  tokenBalances         TokenBalance[]
  tokenTransactions     TokenTransaction[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Tutor application (public onboarding) ----------

model TutorApplication {
  id                String                 @id @default(cuid())
  userId            String?                @unique
  name              String
  email             String
  phone             String
  subjects          String[]
  levels            Level[]
  qualifications    String
  cvUrl             String?
  referenceUrl      String?
  bio               String
  availabilityNotes String?
  status            TutorApplicationStatus @default(PENDING)
  rejectionReason   String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ---------- Tutor profile ----------

model TutorProfile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  slug                     String    @unique
  headline                 String
  bio                      String
  photoUrl                 String?
  subjects                 String[]
  levels                   Level[]
  qualifications           String
  sessionMode              SessionMode @default(BOTH)
  isPublished              Boolean   @default(false)
  bankAccountName          String?
  bankSortCode             String?
  bankAccountNumber        String?
  ratingAverage            Float     @default(0)
  ratingCount              Int       @default(0)
  balancePence             Int       @default(0)
  totalEarnedPence         Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability   TutorAvailabilitySlot[]
  bookings       Booking[]               @relation("TutorBookings")
  conversations  Conversation[]          @relation("ConversationTutorProfile")
  reviews        Review[]                @relation("TutorReviews")
  ledgerEntries  TutorLedgerEntry[]
  payouts        Payout[]
  spotlightPosts Post[]                  @relation("TutorSpotlightPosts")

  @@index([isPublished])
}

model TutorAvailabilitySlot {
  id        String              @id @default(cuid())
  tutorId   String
  dayOfWeek DayOfWeek
  period    AvailabilityPeriod
  createdAt DateTime            @default(now())

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, dayOfWeek, period])
  @@index([tutorId])
}

// ---------- Bookings ----------

model Booking {
  id                      String        @id @default(cuid())
  clientId                String
  tutorId                 String
  subject                 String
  level                   Level
  examBoard               String?
  sessionMode             SessionMode
  startsAt                DateTime
  endsAt                  DateTime
  tokensUsed              Decimal       @default(1) @db.Decimal(6, 2)
  pricePence              Int
  discountPence           Int           @default(0)
  platformFeePence        Int
  tutorPayoutPence        Int
  status                  BookingStatus @default(PENDING_PAYMENT)
  notes                   String?
  cancellationReason      String?
  cancelledAt             DateTime?
  completedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  client        User                @relation("ClientBookings", fields: [clientId], references: [id])
  tutor         TutorProfile        @relation("TutorBookings", fields: [tutorId], references: [id])
  payment       Payment?
  review        Review?
  ledgerEntries TutorLedgerEntry[]

  @@index([clientId])
  @@index([tutorId])
  @@index([status])
}

model Payment {
  id                      String        @id @default(cuid())
  bookingId               String        @unique
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  amountPence             Int
  platformFeePence        Int
  tutorAmountPence        Int
  status                  PaymentStatus @default(PENDING)
  refundedPence           Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// A client's redeemable lesson tokens, tracked per level. One token = one
// standard-length lesson at that level's fixed price, purchased in advance
// and redeemed with any tutor teaching that level.
model TokenBalance {
  id        String   @id @default(cuid())
  userId    String
  level     Level
  balance   Decimal  @default(0) @db.Decimal(6, 2)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level])
  @@index([userId])
}

model TokenTransaction {
  id                      String               @id @default(cuid())
  userId                  String
  level                   Level
  type                    TokenTransactionType
  quantity                Decimal              @db.Decimal(6, 2)
  bookingId               String?
  stripeCheckoutSessionId String?
  description             String
  createdAt               DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TutorLedgerEntry {
  id          String          @id @default(cuid())
  tutorId     String
  type        LedgerEntryType
  amountPence Int
  bookingId   String?
  payoutId    String?
  description String
  createdAt   DateTime        @default(now())

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  booking Booking?     @relation(fields: [bookingId], references: [id])
  payout  Payout?      @relation(fields: [payoutId], references: [id])

  @@index([tutorId, createdAt])
}

model Payout {
  id            String       @id @default(cuid())
  tutorId       String
  amountPence   Int
  status        PayoutStatus @default(PENDING)
  requestedAt   DateTime     @default(now())
  paidAt        DateTime?
  failureReason String?

  tutor         TutorProfile       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  ledgerEntries TutorLedgerEntry[]

  @@index([tutorId])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  tutorId   String
  clientId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutor   TutorProfile @relation("TutorReviews", fields: [tutorId], references: [id], onDelete: Cascade)
  client  User         @relation("ClientReviews", fields: [clientId], references: [id])

  @@index([tutorId])
}

// ---------- Messaging ----------

model Conversation {
  id             String   @id @default(cuid())
  clientId       String
  tutorProfileId String
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  client       User         @relation("ClientConversations", fields: [clientId], references: [id])
  tutorUser    User         @relation("TutorConversations", fields: [tutorUserId], references: [id])
  tutorUserId  String
  tutorProfile TutorProfile @relation("ConversationTutorProfile", fields: [tutorProfileId], references: [id])
  messages     Message[]

  @@unique([clientId, tutorProfileId])
  @@index([tutorProfileId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  flagged        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// ---------- Content ----------

model Post {
  id              String     @id @default(cuid())
  type            PostType
  title           String
  slug            String     @unique
  excerpt         String
  content         String
  coverImageUrl   String?
  authorName      String
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  featuredTutorId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  featuredTutor TutorProfile? @relation("TutorSpotlightPosts", fields: [featuredTutorId], references: [id])

  @@index([type, status, publishedAt])
}

// ---------- Courses ----------

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  status      CourseStatus @default(UPCOMING)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  interests CourseInterest[]

  @@index([status])
}

model CourseInterest {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

// ---------- Newsletter & contact ----------

model NewsletterSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  subscribed       Boolean   @default(true)
  unsubscribeToken String    @unique @default(cuid())
  source           String?
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([subscribed])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  userId    String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------- Audit trail (safeguarding, oversight) ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}
