generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CLIENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Level {
  KS3
  GCSE
  A_LEVEL
  UNIVERSITY_ADMISSIONS
}

enum AvailabilityPeriod {
  MORNING
  AFTERNOON
  EVENING
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionMode {
  ONLINE
  IN_PERSON
  BOTH
}

enum TokenTransactionType {
  PURCHASE
  REDEEM
  REFUND
  ADMIN_GRANT
  ADMIN_REMOVE
}

enum TutorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_TUTOR
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
}

enum LedgerEntryType {
  EARNING
  PLATFORM_FEE
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum PostType {
  BLOG
  NEWS
  TUTOR_SPOTLIGHT
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CourseStatus {
  UPCOMING
  PAST
}

// A CourseDay's "track" drives the bundle-discount pricing logic (see
// src/lib/course-pricing.ts): the discount applies once a selection covers
// every SCIENCE day plus at least one MATHS day. OTHER days never
// participate in a bundle — they're always priced individually. Existing
// Course rows (plain lead-capture courses with no days at all) are
// unaffected; the paid enrollment flow only appears once a course has at
// least one CourseDay.
enum CourseDayTrack {
  MATHS
  SCIENCE
  OTHER
}

enum CoursePaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum CourseEnrollmentStatus {
  AWAITING_DEPOSIT
  DEPOSIT_PAID
  PAID_IN_FULL
  CANCELLED
}

// ---------- Core auth / users ----------

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  name              String
  phone             String?
  role              Role       @default(CLIENT)
  status            UserStatus @default(ACTIVE)
  image             String?
  newsletterOptIn   Boolean    @default(false)
  agreedToTermsAt   DateTime?
  emailVerifiedAt   DateTime?
  // Set on every password change/reset. Compared against the value stashed
  // in a session's JWT at sign-in time (see auth.ts) so that changing a
  // password invalidates any other session issued before that change,
  // instead of leaving them valid for up to the JWT's full lifetime.
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // A client's home address, collected for in-person sessions only.
  // Set either by the client themselves (at signup, or later in their
  // dashboard) or by admin directly (e.g. entering an address Mia already
  // has on file). addressRequestedAt is stamped when admin asks a client
  // to (re-)submit their address — it's informational for the admin UI
  // only, nothing is gated on it.
  addressLine1       String?
  addressLine2       String?
  addressTown        String?
  addressPostcode    String?
  addressRequestedAt DateTime?

  tutorProfile          TutorProfile?
  tutorApplication      TutorApplication?
  bookingsAsClient      Booking[]            @relation("ClientBookings")
  conversationsAsClient Conversation[]       @relation("ClientConversations")
  conversationsAsTutor  Conversation[]       @relation("TutorConversations")
  messagesSent          Message[]            @relation("SentMessages")
  reviewsWritten        Review[]             @relation("ClientReviews")
  passwordResetTokens   PasswordResetToken[]
  auditLogsAsActor      AuditLog[]           @relation("ActorAuditLogs")
  contactMessages       ContactMessage[]
  tokenBalances         TokenBalance[]
  tokenTransactions     TokenTransaction[]
  courseEnrollments     CourseEnrollment[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Tutor application (public onboarding) ----------

model TutorApplication {
  id                String                 @id @default(cuid())
  userId            String?                @unique
  name              String
  email             String
  phone             String
  subjects          String[]
  levels            Level[]
  qualifications    String
  gcseGrades        String
  aLevelGrades      String
  cvUrl             String?
  referenceUrl      String?
  bio               String
  availabilityNotes String?
  status            TutorApplicationStatus @default(PENDING)
  rejectionReason   String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ---------- Tutor profile ----------

model TutorProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  slug              String      @unique
  headline          String
  bio               String
  photoUrl          String?
  subjects          String[]
  levels            Level[]
  qualifications    String
  sessionMode       SessionMode @default(BOTH)
  isPublished       Boolean     @default(false)
  bankAccountName   String?
  bankSortCode      String?
  bankAccountNumber String?
  ratingAverage     Float       @default(0)
  ratingCount       Int         @default(0)
  balancePence      Int         @default(0)
  totalEarnedPence  Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Electronic signature of the Tutor Agreement. agreementRequestedAt is
  // set automatically for every newly-created tutor (so signing is always
  // required at signup), or manually by admin for a specific existing
  // tutor via the Compliance page — existing tutors are never gated on
  // this automatically. Signed once agreementSignedAt is newer than
  // agreementRequestedAt; re-requesting doesn't clear the old signature,
  // so admin can still see what was previously signed until it's replaced.
  agreementRequestedAt DateTime?
  agreementSignedAt    DateTime?
  agreementSignedName  String?
  agreementVersion     String?

  // A copy of the tutor's DBS (criminal record) check, uploaded by the
  // tutor and viewable by admin. Stored as a private Vercel Blob — access
  // is only ever through the authenticated download route, never a bare
  // public URL.
  dbsCheckUrl        String?
  dbsCheckFileName   String?
  dbsCheckUploadedAt DateTime?

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability   TutorAvailabilitySlot[]
  bookings       Booking[]               @relation("TutorBookings")
  conversations  Conversation[]          @relation("ConversationTutorProfile")
  reviews        Review[]                @relation("TutorReviews")
  ledgerEntries  TutorLedgerEntry[]
  payouts        Payout[]
  spotlightPosts Post[]                  @relation("TutorSpotlightPosts")

  @@index([isPublished])
}

model TutorAvailabilitySlot {
  id        String             @id @default(cuid())
  tutorId   String
  dayOfWeek DayOfWeek
  period    AvailabilityPeriod
  createdAt DateTime           @default(now())

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, dayOfWeek, period])
  @@index([tutorId])
}

// ---------- Bookings ----------

model Booking {
  id                 String        @id @default(cuid())
  clientId           String
  tutorId            String
  subject            String
  level              Level
  examBoard          String?
  sessionMode        SessionMode
  startsAt           DateTime
  endsAt             DateTime
  tokensUsed         Decimal       @default(1) @db.Decimal(6, 2)
  pricePence         Int
  discountPence      Int           @default(0)
  platformFeePence   Int
  tutorPayoutPence   Int
  status             BookingStatus @default(PENDING_PAYMENT)
  notes              String?
  cancellationReason String?
  cancelledAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Groups the occurrences of a recurring weekly series together (null for
  // a one-off booking). Not a foreign key to another table — there's no
  // separate "series" record, just a shared id across the individual
  // Booking rows the series creates.
  seriesId              String?
  // False when this CONFIRMED booking was scheduled before the client had
  // enough tokens to cover it (only possible for recurring sessions — see
  // scheduleSession). No Payment or REDEEM TokenTransaction exists yet in
  // that case; a token is claimed for it automatically the moment the
  // client's balance covers it (a purchase, an admin grant, or editing the
  // booking), and a reminder email goes out if it's still unpaid on the
  // day.
  tokensReserved        Boolean   @default(true)
  paymentReminderSentAt DateTime?

  client        User               @relation("ClientBookings", fields: [clientId], references: [id])
  tutor         TutorProfile       @relation("TutorBookings", fields: [tutorId], references: [id])
  payment       Payment?
  review        Review?
  ledgerEntries TutorLedgerEntry[]

  @@index([clientId])
  @@index([tutorId])
  @@index([status])
  @@index([seriesId])
}

model Payment {
  id                      String        @id @default(cuid())
  bookingId               String        @unique
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  amountPence             Int
  platformFeePence        Int
  tutorAmountPence        Int
  status                  PaymentStatus @default(PENDING)
  refundedPence           Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// A client's redeemable lesson tokens, tracked per level. One token = one
// standard-length lesson at that level's fixed price, purchased in advance
// and redeemed with any tutor teaching that level.
model TokenBalance {
  id        String   @id @default(cuid())
  userId    String
  level     Level
  balance   Decimal  @default(0) @db.Decimal(6, 2)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level])
  @@index([userId])
}

model TokenTransaction {
  id                      String               @id @default(cuid())
  userId                  String
  level                   Level
  type                    TokenTransactionType
  quantity                Decimal              @db.Decimal(6, 2)
  bookingId               String?
  // Unique (Postgres allows any number of NULLs here) so a redelivered
  // Stripe webhook event can never credit the same checkout session's
  // tokens twice — see the webhook handler's idempotency check.
  stripeCheckoutSessionId String?              @unique
  description             String
  createdAt               DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TutorLedgerEntry {
  id          String          @id @default(cuid())
  tutorId     String
  type        LedgerEntryType
  amountPence Int
  bookingId   String?
  payoutId    String?
  description String
  createdAt   DateTime        @default(now())

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  booking Booking?     @relation(fields: [bookingId], references: [id])
  payout  Payout?      @relation(fields: [payoutId], references: [id])

  @@index([tutorId, createdAt])
}

// A partial unique index (Payout_tutorId_one_pending, added via migration
// since Prisma's @@unique can't be filtered by WHERE) enforces at most one
// PENDING row per tutorId at the database level — see requestBankPayout().
model Payout {
  id            String       @id @default(cuid())
  tutorId       String
  amountPence   Int
  status        PayoutStatus @default(PENDING)
  requestedAt   DateTime     @default(now())
  paidAt        DateTime?
  failureReason String?

  tutor         TutorProfile       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  ledgerEntries TutorLedgerEntry[]

  @@index([tutorId])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  tutorId   String
  clientId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutor   TutorProfile @relation("TutorReviews", fields: [tutorId], references: [id], onDelete: Cascade)
  client  User         @relation("ClientReviews", fields: [clientId], references: [id])

  @@index([tutorId])
}

// Free-form session feedback submitted from the public /feedback page — not
// tied to a specific booking or a logged-in account, unlike Review above.
model Feedback {
  id             String   @id @default(cuid())
  clientName     String
  tutorName      String
  rating         Int
  helpfulText    String
  improveText    String?
  consentToShare Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// ---------- Messaging ----------

model Conversation {
  id                           String    @id @default(cuid())
  clientId                     String
  tutorProfileId               String
  lastMessageAt                DateTime  @default(now())
  createdAt                    DateTime  @default(now())
  // Set the first time the tutor is emailed about a new client on this
  // conversation. An atomic conditional update on this column (only set
  // when null) is what guarantees that email is sent exactly once even if
  // the client's first message is submitted twice concurrently.
  firstClientMessageNotifiedAt DateTime?

  client       User         @relation("ClientConversations", fields: [clientId], references: [id])
  tutorUser    User         @relation("TutorConversations", fields: [tutorUserId], references: [id])
  tutorUserId  String
  tutorProfile TutorProfile @relation("ConversationTutorProfile", fields: [tutorProfileId], references: [id])
  messages     Message[]

  @@unique([clientId, tutorProfileId])
  @@index([tutorProfileId])
}

model Message {
  id                  String    @id @default(cuid())
  conversationId      String
  senderId            String
  body                String
  attachmentUrl       String?
  attachmentName      String?
  attachmentType      String?
  attachmentSizeBytes Int?
  readAt              DateTime?
  flagged             Boolean   @default(false)
  // Set once an "unread message" reminder email has been sent for this
  // message, so the hourly cron job doesn't email the recipient twice.
  reminderSentAt      DateTime?
  createdAt           DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([readAt, reminderSentAt, createdAt])
}

// ---------- Content ----------

model Post {
  id              String     @id @default(cuid())
  type            PostType
  title           String
  slug            String     @unique
  excerpt         String
  content         String
  coverImageUrl   String?
  authorName      String
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  featuredTutorId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  featuredTutor TutorProfile? @relation("TutorSpotlightPosts", fields: [featuredTutorId], references: [id])

  @@index([type, status, publishedAt])
}

// ---------- Courses ----------

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  status      CourseStatus @default(UPCOMING)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Free-text venue and daily time shown on the course page and in
  // confirmation emails, e.g. "EC" / "9am – 3pm each day". Both optional so
  // a plain lead-capture course (no paid days) doesn't need them.
  venue     String?
  timeLabel String?

  // Set only once this course has paid CourseDay rows — that's what turns
  // on the enroll-and-pay flow on the course page instead of the plain
  // "register interest" form. bundlePricePence/bundleLabel describe the
  // one bundle discount this course offers (see src/lib/course-pricing.ts);
  // leave both null for a course with no bundle, just individual days.
  bundlePricePence Int?
  bundleLabel      String?
  // Flat percentage of the total price collected as a deposit at signup —
  // the rest is due on balanceDueDate. 25 means 25%.
  depositPercent   Int?
  balanceDueDate   DateTime?

  interests    CourseInterest[]
  days         CourseDay[]
  enrollments  CourseEnrollment[]
  testimonials CourseTestimonial[]

  @@index([status])
}

// A quote from a past student/parent, added by admin (never generated) for
// display on a course page. courseId is optional so a testimonial can also
// be general (not tied to any specific course); onDelete SetNull keeps a
// testimonial around even if the course it was about is later removed.
model CourseTestimonial {
  id          String   @id @default(cuid())
  courseId    String?
  studentName String
  // e.g. "Parent of Year 11 student", "Year 10, Summer School 2026" —
  // shown under the name on the testimonial card.
  role        String?
  subject     String?
  quote       String
  rating      Int?
  // Whether this testimonial is eligible to show on a course page's
  // testimonials section. Lets admin keep old/unused quotes without
  // deleting them.
  featured    Boolean  @default(true)
  createdAt   DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([courseId])
}

model CourseInterest {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

// One selectable day of a paid multi-day course, e.g. "Foundation Maths"
// on 26 October. pricePence is what that single day costs on its own; see
// src/lib/course-pricing.ts for how days combine with Course.bundlePricePence.
model CourseDay {
  id         String         @id @default(cuid())
  courseId   String
  date       DateTime
  label      String
  track      CourseDayTrack @default(OTHER)
  pricePence Int
  // Max students who can book this day. Null means unlimited. Counted
  // against CourseEnrollment rows with depositStatus PAID (see
  // src/lib/course-capacity.ts) — a spot is only taken once someone has
  // actually paid their deposit, not merely started checkout.
  capacity   Int?
  sortOrder  Int            @default(0)

  course      Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments CourseEnrollmentDay[]

  @@index([courseId])
}

// A client's paid signup for one or more days of a course. Deposit and
// balance are tracked separately since they're two distinct Stripe
// Checkout Sessions paid at different times (see
// src/lib/actions/course-enrollment.ts and the Stripe webhook) — the
// deposit is paid immediately at signup, the balance via a payment link
// emailed nearer Course.balanceDueDate (or paid early from the dashboard).
model CourseEnrollment {
  id       String  @id @default(cuid())
  courseId String
  // Null for a guest checkout (no account) — see guestName/guestEmail/
  // guestPhone below, which are set instead in that case.
  clientId String?

  // Set instead of clientId when someone books as a guest, without an
  // account. There's no access token for these bookings — a guest who
  // needs to pay their balance later enters this email address on the
  // pay-balance page to confirm it's their booking (see
  // requestGuestCourseBalancePayment).
  guestName  String?
  guestEmail String?
  guestPhone String?

  // Answers to the "about your child" questions asked at signup — kept as
  // JSON (rather than fixed columns) since the question set is defined in
  // COURSE_CHILD_QUESTIONS and may change over time without a migration.
  // childName is pulled out as its own column purely so admin tables/CSV
  // exports don't need to reach into the JSON for the one field they
  // always show.
  childName    String
  childAnswers Json

  // Electronic signature of the course Terms & Conditions, same pattern as
  // TutorProfile.agreementSigned* — a typed name plus timestamp, no IP.
  termsSignedAt   DateTime
  termsSignedName String
  termsVersion    String

  totalPence   Int
  depositPence Int
  balancePence Int

  depositStatus            CoursePaymentStatus @default(PENDING)
  depositCheckoutSessionId String?             @unique
  depositPaidAt            DateTime?

  balanceStatus             CoursePaymentStatus @default(PENDING)
  balanceCheckoutSessionId  String?
  balancePaidAt             DateTime?
  // Set when the balance-due reminder email has gone out, so the daily
  // cron doesn't email the same enrollment twice.
  balanceReminderSentAt     DateTime?
  // Set when admin marks the balance paid manually (e.g. paid by bank
  // transfer instead of the payment link) rather than via Stripe.
  balancePaidManuallyByName String?

  status CourseEnrollmentStatus @default(AWAITING_DEPOSIT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course                @relation(fields: [courseId], references: [id])
  client User?                 @relation(fields: [clientId], references: [id])
  days   CourseEnrollmentDay[]

  @@index([courseId])
  @@index([clientId])
}

model CourseEnrollmentDay {
  id           String @id @default(cuid())
  enrollmentId String
  dayId        String

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  day        CourseDay        @relation(fields: [dayId], references: [id])

  @@unique([enrollmentId, dayId])
  @@index([dayId])
}

// ---------- Newsletter & contact ----------

model NewsletterSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  subscribed       Boolean   @default(true)
  unsubscribeToken String    @unique @default(cuid())
  source           String?
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([subscribed])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  userId    String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------- Audit trail (safeguarding, oversight) ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}
