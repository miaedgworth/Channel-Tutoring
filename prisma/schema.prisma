generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  CLIENT
  TUTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Level {
  GCSE
  A_LEVEL
}

enum DbsStatus {
  NOT_PROVIDED
  PENDING
  VERIFIED
}

enum TutorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_TUTOR
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
}

enum LedgerEntryType {
  EARNING
  PLATFORM_FEE
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum PostType {
  BLOG
  NEWS
  TUTOR_SPOTLIGHT
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// ---------- Core auth / users ----------

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role       @default(CLIENT)
  status          UserStatus @default(ACTIVE)
  image           String?
  newsletterOptIn Boolean    @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tutorProfile          TutorProfile?
  tutorApplication      TutorApplication?
  bookingsAsClient      Booking[]            @relation("ClientBookings")
  conversationsAsClient Conversation[]       @relation("ClientConversations")
  conversationsAsTutor  Conversation[]       @relation("TutorConversations")
  messagesSent          Message[]            @relation("SentMessages")
  reviewsWritten        Review[]             @relation("ClientReviews")
  passwordResetTokens   PasswordResetToken[]
  auditLogsAsActor      AuditLog[]           @relation("ActorAuditLogs")
  contactMessages       ContactMessage[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Tutor application (public onboarding) ----------

model TutorApplication {
  id                String                 @id @default(cuid())
  userId            String?                @unique
  name              String
  email             String
  phone             String
  subjects          String[]
  levels            Level[]
  examBoards        String[]
  yearsExperience   Int
  qualifications    String
  dbsStatus         DbsStatus              @default(NOT_PROVIDED)
  cvUrl             String?
  referenceUrl      String?
  bio               String
  availabilityNotes String?
  status            TutorApplicationStatus @default(PENDING)
  rejectionReason   String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ---------- Tutor profile ----------

model TutorProfile {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  slug                     String    @unique
  headline                 String
  bio                      String
  photoUrl                 String?
  subjects                 String[]
  levels                   Level[]
  examBoards               String[]
  hourlyRatePence          Int
  yearsExperience          Int
  qualifications           String
  dbsStatus                DbsStatus @default(NOT_PROVIDED)
  isPublished              Boolean   @default(false)
  stripeConnectAccountId   String?
  stripeOnboardingComplete Boolean   @default(false)
  ratingAverage            Float     @default(0)
  ratingCount              Int       @default(0)
  balancePence             Int       @default(0)
  totalEarnedPence         Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability   TutorAvailabilitySlot[]
  bookings       Booking[]               @relation("TutorBookings")
  conversations  Conversation[]          @relation("ConversationTutorProfile")
  reviews        Review[]                @relation("TutorReviews")
  ledgerEntries  TutorLedgerEntry[]
  payouts        Payout[]
  spotlightPosts Post[]                  @relation("TutorSpotlightPosts")

  @@index([isPublished])
}

model TutorAvailabilitySlot {
  id        String   @id @default(cuid())
  tutorId   String
  startsAt  DateTime
  endsAt    DateTime
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  booking Booking?

  @@index([tutorId, startsAt])
}

// ---------- Bookings ----------

model Booking {
  id                      String        @id @default(cuid())
  clientId                String
  tutorId                 String
  slotId                  String?       @unique
  subject                 String
  level                   Level
  examBoard               String?
  startsAt                DateTime
  endsAt                  DateTime
  pricePence              Int
  platformFeePence        Int
  tutorPayoutPence        Int
  status                  BookingStatus @default(PENDING_PAYMENT)
  notes                   String?
  cancellationReason      String?
  cancelledAt             DateTime?
  completedAt             DateTime?
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  client        User                   @relation("ClientBookings", fields: [clientId], references: [id])
  tutor         TutorProfile           @relation("TutorBookings", fields: [tutorId], references: [id])
  slot          TutorAvailabilitySlot? @relation(fields: [slotId], references: [id])
  payment       Payment?
  review        Review?
  ledgerEntries TutorLedgerEntry[]

  @@index([clientId])
  @@index([tutorId])
  @@index([status])
}

model Payment {
  id                      String        @id @default(cuid())
  bookingId               String        @unique
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  amountPence             Int
  platformFeePence        Int
  tutorAmountPence        Int
  status                  PaymentStatus @default(PENDING)
  refundedPence           Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model TutorLedgerEntry {
  id          String          @id @default(cuid())
  tutorId     String
  type        LedgerEntryType
  amountPence Int
  bookingId   String?
  payoutId    String?
  description String
  createdAt   DateTime        @default(now())

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  booking Booking?     @relation(fields: [bookingId], references: [id])
  payout  Payout?      @relation(fields: [payoutId], references: [id])

  @@index([tutorId, createdAt])
}

model Payout {
  id               String       @id @default(cuid())
  tutorId          String
  amountPence      Int
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?
  requestedAt      DateTime     @default(now())
  paidAt           DateTime?
  failureReason    String?

  tutor         TutorProfile       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  ledgerEntries TutorLedgerEntry[]

  @@index([tutorId])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  tutorId   String
  clientId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tutor   TutorProfile @relation("TutorReviews", fields: [tutorId], references: [id], onDelete: Cascade)
  client  User         @relation("ClientReviews", fields: [clientId], references: [id])

  @@index([tutorId])
}

// ---------- Messaging ----------

model Conversation {
  id             String   @id @default(cuid())
  clientId       String
  tutorProfileId String
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  client       User         @relation("ClientConversations", fields: [clientId], references: [id])
  tutorUser    User         @relation("TutorConversations", fields: [tutorUserId], references: [id])
  tutorUserId  String
  tutorProfile TutorProfile @relation("ConversationTutorProfile", fields: [tutorProfileId], references: [id])
  messages     Message[]

  @@unique([clientId, tutorProfileId])
  @@index([tutorProfileId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  flagged        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

// ---------- Content ----------

model Post {
  id              String     @id @default(cuid())
  type            PostType
  title           String
  slug            String     @unique
  excerpt         String
  content         String
  coverImageUrl   String?
  authorName      String
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  featuredTutorId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  featuredTutor TutorProfile? @relation("TutorSpotlightPosts", fields: [featuredTutorId], references: [id])

  @@index([type, status, publishedAt])
}

// ---------- Newsletter & contact ----------

model NewsletterSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  subscribed       Boolean   @default(true)
  unsubscribeToken String    @unique @default(cuid())
  source           String?
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([subscribed])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  userId    String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------- Audit trail (safeguarding, oversight) ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}
